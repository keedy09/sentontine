@startuml SenTontine_UseCases
title SenTontine - Diagramme de Cas d'Utilisation

actor Membre as member
actor Admin as admin

rectangle SenTontine {
  usecase "Consulter Tontines" as UC1
  usecase "Effectuer un Paiement" as UC2
  usecase "Consulter Statistiques" as UC3
  usecase "Valider les Paiements" as UC4
  usecase "Gérer les Paiements" as UC5
  usecase "Générer Rapports" as UC6
  usecase "Voir Détails Tontine" as UC7
  usecase "Télécharger Reçu" as UC8
  usecase "Partager Paiement" as UC9
  
  member --> UC1
  member --> UC2
  member --> UC3
  member --> UC7
  
  admin --> UC4
  admin --> UC5
  admin --> UC6
  admin --> UC7
  
  UC2 .> UC8 : include
  UC2 .> UC9 : include
  UC5 .> UC4 : include
  UC6 .> UC3 : include
}

@enduml
